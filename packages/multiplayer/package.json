{
  "name": "@magmacrunch/adenosine-multiplayer",
  "version": "0.4.1",
  "type": "module",
  "description": "Game-agnostic multiplayer WebSocket client for browser games",
  "license": "Apache-2.0",
  "keywords": ["multiplayer", "websocket", "game", "lobby", "board-game", "real-time"],
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "https://github.com/magmacrunchmedia/adenosine",
    "directory": "packages/multiplayer"
  },
  "author": "magmacrunch media",
  "homepage": "https://github.com/magmacrunchmedia/adenosine#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lobby.css": "./lobby.css"
  },
  "files": [
    "dist",
    "lobby.css",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.1"
  }
}
