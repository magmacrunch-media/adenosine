{
  "name": "@magmacrunch/adenosine-rpg",
  "version": "0.3.0",
  "type": "module",
  "description": "Lightweight 2D tile-based RPG engine",
  "license": "Apache-2.0",
  "keywords": [
    "rpg",
    "2d",
    "tile-based",
    "game-engine",
    "canvas",
    "2d-game"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacrunch-media/adenosine.git",
    "directory": "packages/rpg"
  },
  "author": "magmacrunch media",
  "homepage": "https://magmacrunch.com/ware/adenosine/",
  "main": "dist/index.js",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "API.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "build:js": "tsup",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
