{
  "name": "@magmacrunch/adenosine-puzzle",
  "version": "0.2.0",
  "type": "module",
  "description": "Sliding tile puzzle framework — grid engine, input, rendering, scoring",
  "license": "LGPL-2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/magmacrunchmedia/adenosine",
    "directory": "packages/puzzle"
  },
  "author": "magmacrunch media",
  "homepage": "https://github.com/magmacrunchmedia/adenosine#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": ["dist", "styles.css"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.1"
  }
}
