{
  "name": "@magmacrunch/adenosine-puzzle",
  "version": "0.2.2",
  "type": "module",
  "description": "Sliding tile puzzle framework \u2014 grid engine, input, rendering, scoring",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/magmacrunchmedia/adenosine",
    "directory": "packages/puzzle"
  },
  "author": "magmacrunch media",
  "homepage": "https://github.com/magmacrunchmedia/adenosine#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./puzzle-base.css": "./puzzle-base.css",
    "./puzzle-grid.css": "./puzzle-grid.css",
    "./puzzle-modals.css": "./puzzle-modals.css",
    "./puzzle-responsive.css": "./puzzle-responsive.css"
  },
  "files": [
    "dist",
    "puzzle-base.css",
    "puzzle-grid.css",
    "puzzle-modals.css",
    "puzzle-responsive.css",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.1"
  }
}
