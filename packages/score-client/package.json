{
  "name": "@magmacrunch/adenosine-score-client",
  "version": "0.2.3",
  "type": "module",
  "description": "WebSocket high score client with localStorage fallback",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/magmacrunchmedia/adenosine",
    "directory": "packages/score-client"
  },
  "author": "magmacrunch media",
  "homepage": "https://github.com/magmacrunchmedia/adenosine#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.1"
  }
}
