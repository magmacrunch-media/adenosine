{
  "name": "@magmacrunch/adenosine-score-client",
  "version": "0.2.5",
  "type": "module",
  "description": "WebSocket high score client with localStorage fallback",
  "license": "Apache-2.0",
  "keywords": [
    "high-scores",
    "leaderboard",
    "websocket",
    "game-scores",
    "localStorage"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacrunchmedia/adenosine.git",
    "directory": "packages/score-client"
  },
  "author": "magmacrunch media",
  "homepage": "https://magmacrunch.com/ware/adenosine/",
  "main": "dist/index.js",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "API.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.1"
  },
  "sideEffects": false
}
