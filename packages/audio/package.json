{
  "name": "@magmacrunch/adenosine-audio",
  "version": "0.3.0",
  "type": "module",
  "description": "Web Audio API engine for game music and sound effects",
  "license": "Apache-2.0",
  "keywords": [
    "web-audio",
    "game-audio",
    "music",
    "sound-effects",
    "sfx",
    "game-engine"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacrunchmedia/adenosine.git",
    "directory": "packages/audio"
  },
  "author": "magmacrunch media",
  "homepage": "https://magmacrunch.com/ware/adenosine/",
  "main": "dist/index.js",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "API.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
