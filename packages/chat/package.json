{
  "name": "@magmacrunch/adenosine-chat",
  "version": "0.3.0",
  "type": "module",
  "description": "Floating real-time chat widget with SharedWorker for browser games",
  "license": "LGPL-2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/magmacrunchmedia/adenosine",
    "directory": "packages/chat"
  },
  "author": "magmacrunch media",
  "homepage": "https://github.com/magmacrunchmedia/adenosine#readme",
  "main": "dist/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat-widget.css": "./chat-widget.css",
    "./chat-worker.js": "./dist/chat-worker.js"
  },
  "files": [
    "dist",
    "chat-widget.css",
    "src/index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && cp src/chat-worker.js dist/chat-worker.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "vitest": "^3.2.1"
  }
}
