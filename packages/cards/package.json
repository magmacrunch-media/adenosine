{
  "name": "@magmacrunch/adenosine-cards",
  "version": "0.8.0",
  "type": "module",
  "description": "Card deck, pixel-art rendering, and poker chip animations",
  "license": "Apache-2.0",
  "keywords": [
    "cards",
    "card-game",
    "poker",
    "svg",
    "pixel-art",
    "deck",
    "game-engine"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmacrunch-media/adenosine.git",
    "directory": "packages/cards"
  },
  "author": "magmacrunch media",
  "homepage": "https://magmacrunch.com/ware/adenosine/",
  "main": "dist/index.js",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js",
    "./cards.css": "./cards.css",
    "./chip-animation.css": "./chip-animation.css"
  },
  "files": [
    "dist",
    "cards.css",
    "chip-animation.css",
    "NOTICE",
    "API.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
